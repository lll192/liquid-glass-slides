{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Liquid Glass Slides Media Manifest",
  "type": "object",
  "required": ["schema_version", "deck_id", "assets", "reviewed"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "deck_id": {"type": "string", "minLength": 1},
    "reviewed": {"type": "boolean"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "origin", "role", "local_path", "slide_ids", "alt"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
          "origin": {"enum": ["web", "ai-generated", "user-provided", "project-asset"]},
          "role": {"enum": ["hero", "content", "background", "decorative", "reference"]},
          "local_path": {"type": "string", "minLength": 1},
          "slide_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "alt": {"type": "string", "minLength": 1},
          "fit": {"enum": ["contain", "cover"]},
          "focal_point": {"type": "string", "pattern": "^\\d{1,3}%\\s+\\d{1,3}%$"},
          "source_url": {"type": "string"},
          "download_url": {"type": "string"},
          "author": {"type": "string"},
          "license": {"type": "string"},
          "license_url": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
