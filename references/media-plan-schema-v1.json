{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Liquid Glass Slides Web Media Plan",
  "type": "object",
  "required": ["deck_id", "requests"],
  "properties": {
    "schema_version": {"const": "1.0", "default": "1.0"},
    "deck_id": {"type": "string", "minLength": 1},
    "image_dir": {"type": "string", "default": "images/web"},
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["asset_id", "query", "role", "slide_ids", "alt"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
          "query": {"type": "string", "minLength": 1},
          "openverse_id": {"type": "string"},
          "role": {"enum": ["hero", "content", "background", "decorative", "reference"]},
          "slide_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "alt": {"type": "string", "minLength": 1},
          "fit": {"enum": ["contain", "cover"]},
          "focal_point": {"type": "string", "pattern": "^\\d{1,3}%\\s+\\d{1,3}%$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
